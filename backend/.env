# ====================================
# PeoTraveller Backend Configuration
# ====================================

# ============ DATABASE CONFIGURATION ============
# For SQLite (development - simple, no setup needed):
DATABASE_URL=sqlite:///./peotraveller.db

# For PostgreSQL (recommended for production):
# First, create a database: createdb peotraveller
# Then use:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/peotraveller
# DATABASE_URL=postgresql://username:password@host:port/database_name

# ============ JWT SECURITY ============
# Change this to a strong random string in production!
SECRET_KEY=your_super_secret_key_here_change_in_production_to_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ PROJECT INFO ============
PROJECT_NAME=PeoTraveller API

# ====================================
# SETUP INSTRUCTIONS
# ====================================
# 1. Copy this file: cp .env.example .env
# 2. Update values for your environment
# 3. For production, generate a secure SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
